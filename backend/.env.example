DATABASE_URL=postgresql://systemize:systemize_dev@db:5432/systemize
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-this-in-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_RAW=systemize-raw-reports
S3_BUCKET_OUTPUTS=systemize-outputs
ANTHROPIC_API_KEY=
ENVIRONMENT=development
# Secures the /api/v1/webhook/bureau endpoints used by Proclaim.
# Set to a strong random string in production. Leave blank to disable auth (dev only).
PROCLAIM_WEBHOOK_API_KEY=

# ── IRL case intake (PCP platform -> us) ─────────────────────────────────────
# Inbound: secures POST /api/v1/webhook/irl-case. Set to the IRL_API_KEY the PCP
# platform sends (sk_irlcase_*). Leave blank to disable auth (dev only).
IRL_CASE_API_KEY=
# Outbound: where we POST each assessment outcome back, and the key we send.
PCP_OUTCOME_URL=https://api-production-ae9a.up.railway.app/api/v1/webhook/irl-outcome
PCP_OUTCOME_API_KEY=
